# Sacred Gatekeeper — Environment Variables
# Copy to .env and fill in real values.
# Never commit .env to source control.

# ── Broker network ────────────────────────────────────────────────────────────
# TCP address the interceptor connects to (change if broker runs on another host)
SG_TCP_HOST=127.0.0.1
SG_TCP_PORT=9999

# HTTP address the phone app polls (use 0.0.0.0 to accept LAN connections)
SG_HTTP_HOST=0.0.0.0
SG_HTTP_PORT=9998

# ── Interceptor ───────────────────────────────────────────────────────────────
SG_BROKER_HOST=127.0.0.1
SG_BROKER_PORT=9999
SG_CONFIG=rules.toml
SG_BROKER_RETRIES=3
SG_RETRY_BASE_S=0.3

# ── Persistence ───────────────────────────────────────────────────────────────
SG_LEDGER=ledger.db
SG_PHONE_PUB=phone_public.pem
SG_PHONE_PRIV=phone_private.pem

# ── Supabase relay (optional — used for remote/mobile decision sync) ─────────
# Get these from: https://supabase.com/dashboard → Project → Settings → API
SG_SUPABASE_URL=
SG_SUPABASE_SERVICE_KEY=

# ── Broker hardening ─────────────────────────────────────────────────────────
# Keep remote pairing disabled unless you intentionally want to pair devices
# from outside localhost.
SG_ALLOW_REMOTE_PAIRING=false
SG_PAIRING_RATE_LIMIT=5
SG_PAIRING_WINDOW_S=300
SG_REGISTER_RATE_LIMIT=20
SG_REGISTER_WINDOW_S=300
SG_DECISION_RATE_LIMIT=120
SG_DECISION_WINDOW_S=60
SG_REVOKE_RATE_LIMIT=10
SG_REVOKE_WINDOW_S=300

# ── Phone app (Expo) ──────────────────────────────────────────────────────────
# Set this to the LAN IP of the machine running the broker so your phone can
# reach it.  Example: EXPO_PUBLIC_BROKER_HTTP=http://192.168.1.10:9998
EXPO_PUBLIC_BROKER_HTTP=http://127.0.0.1:9998
EXPO_PUBLIC_EXPO_PROJECT_ID=
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EAS_PROJECT_ID=
ANDROID_APPLICATION_ID=com.sacredgatekeeper.kernel
IOS_BUNDLE_IDENTIFIER=com.sacredgatekeeper.kernel
